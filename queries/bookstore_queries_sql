----------------------------------------------

select books.id ,books.title,
sum(order_item.quantity)as total_sold
from books
join order_item on book_id= order_item.book_id
group by books.id ,books.title
order by total_sold desc
 limit 5;
-----------------------------------------------------

SELECT authors.country,
       SUM(order_item.quantity) AS total_sold
FROM authors
JOIN books
    ON authors.id = books.author_id
JOIN order_item
    ON books.id = order_item.book_id
GROUP BY authors.country;

-------------------------------------------
SELECT customers.id,
       customers.name,
       COUNT(orders.id) AS order_count
FROM customers
LEFT JOIN orders
    ON customers.id = orders.customer_id
GROUP BY customers.id, customers.name
HAVING COUNT(orders.id) < 2;
------------------------------------------
SELECT order_item.order_id,
       COUNT(DISTINCT order_item.book_id) AS different_books
FROM order_item
GROUP BY order_item.order_id
HAVING COUNT(DISTINCT order_item.book_id) >= 3;