SELECT authors.name,
count(books.id)as total_books
from authors
LEFT JOIN 
books ON authors.id = books.author_id
group by authors.id, authors.name;
---------------

SELECT authors.id,authors.name ,count(books.id)
from authors
join books ON authors.id = books.author_id
group by authors.id, authors.name
having count(books.id)>3;
---------------------

select  country ,count(*) as authors_count
from authors
group by country
having count(*)>1;


select customers.name, sum( order_item.cost)as total_order_price 
from customers
join orders on
 customers.id= orders.customer_id
 join order_item
 on orders.id= order_item.order_id
group by customers.name
order by total_order_price desc
limit 5;


